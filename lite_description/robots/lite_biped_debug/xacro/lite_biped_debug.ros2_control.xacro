<?xml version="1.0"?>
<!-- GENERATED by lite_description.workflow from Onshape CAD. Do not edit by hand. Regenerate: lite-description-generate lite_biped_debug -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One joint: 5 command + 3 state interfaces (MIT mode).
       The params are read by humanoid_devices_robstride. The mock and MuJoCo backends
       ignore params they do not know, so this one macro serves all three. -->
  <xacro:macro name="lite_biped_debug_joint"
               params="name can_id model direction lower_limit upper_limit torque_limit
                       current_limit">
    <joint name="${name}">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="stiffness"/>
      <command_interface name="damping"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="can_id">${can_id}</param>
      <param name="model">${model}</param>
      <param name="direction">${direction}</param>
      <param name="lower_limit">${lower_limit}</param>
      <param name="upper_limit">${upper_limit}</param>
      <param name="torque_limit">${torque_limit}</param>
      <param name="current_limit">${current_limit}</param>
    </joint>
  </xacro:macro>

  <!-- A joint driven through a four-bar linkage, otherwise identical to
       lite_biped_debug_joint. The geometry is a physical fact, so it is always published:
       calibrate_robot reads it from /robot_description to refer the URDF joint limits into
       actuator space even on the runs where the plugin must not apply the transform.
       linkage_enabled is the switch for that. With it true, RobstrideSystem converts
       joint<->actuator through the linkage and refers the commanded impedance by J^2, so
       /joint_states and every controller speak true joint space. Calibration sets it
       false, because it needs raw actuator angles. -->
  <xacro:macro name="lite_biped_debug_linkage_joint"
               params="name can_id model direction lower_limit upper_limit torque_limit
                       current_limit linkage_ground linkage_crank_in linkage_coupler
                       linkage_crank_out linkage_alpha_zero linkage_sign use_linkage">
    <joint name="${name}">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="stiffness"/>
      <command_interface name="damping"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="can_id">${can_id}</param>
      <param name="model">${model}</param>
      <param name="direction">${direction}</param>
      <param name="lower_limit">${lower_limit}</param>
      <param name="upper_limit">${upper_limit}</param>
      <param name="torque_limit">${torque_limit}</param>
      <param name="current_limit">${current_limit}</param>
      <param name="linkage_ground">${linkage_ground}</param>
      <param name="linkage_crank_in">${linkage_crank_in}</param>
      <param name="linkage_coupler">${linkage_coupler}</param>
      <param name="linkage_crank_out">${linkage_crank_out}</param>
      <param name="linkage_alpha_zero">${linkage_alpha_zero}</param>
      <param name="linkage_sign">${linkage_sign}</param>
      <param name="linkage_enabled">${use_linkage}</param>
    </joint>
  </xacro:macro>

  <xacro:macro name="lite_biped_debug_left_leg_joints" params="use_linkage:=true">
    <xacro:lite_biped_debug_joint name="left_hip_pitch" can_id="31" model="rs-06" direction="-1"
                                  lower_limit="-2.35619" upper_limit="0.785398"
                                  torque_limit="36.0" current_limit="43"/>
    <xacro:lite_biped_debug_joint name="left_hip_roll" can_id="32" model="rs-06" direction="1"
                                  lower_limit="-0.349066" upper_limit="1.5708" torque_limit="36.0"
                                  current_limit="43"/>
    <xacro:lite_biped_debug_joint name="left_hip_yaw" can_id="33" model="rs-02" direction="1"
                                  lower_limit="-1.5708" upper_limit="1.5708" torque_limit="17.0"
                                  current_limit="27"/>
    <xacro:lite_biped_debug_joint name="left_knee_pitch" can_id="34" model="rs-06" direction="-1"
                                  lower_limit="0.0" upper_limit="2.35619" torque_limit="36.0"
                                  current_limit="43"/>
    <xacro:lite_biped_debug_joint name="left_ankle_yaw" can_id="35" model="rs-00" direction="1"
                                  lower_limit="-1.5708" upper_limit="1.5708" torque_limit="14.0"
                                  current_limit="16"/>
    <xacro:lite_biped_debug_linkage_joint name="left_ankle_pitch" can_id="36" model="rs-00"
                                          direction="1" lower_limit="-0.523599"
                                          upper_limit="0.872665" torque_limit="14.0"
                                          current_limit="16" linkage_ground="160.449369"
                                          linkage_crank_in="40.0" linkage_coupler="150.0"
                                          linkage_crank_out="40.0" linkage_alpha_zero="338.82213"
                                          linkage_sign="1" use_linkage="${use_linkage}"/>
    <xacro:lite_biped_debug_joint name="left_ankle_roll" can_id="37" model="rs-05" direction="-1"
                                  lower_limit="-0.349066" upper_limit="0.349066"
                                  torque_limit="5.5" current_limit="14"/>
  </xacro:macro>

  <xacro:macro name="lite_biped_debug_right_leg_joints" params="use_linkage:=true">
    <xacro:lite_biped_debug_joint name="right_hip_pitch" can_id="41" model="rs-06" direction="1"
                                  lower_limit="-2.35619" upper_limit="0.785398"
                                  torque_limit="36.0" current_limit="43"/>
    <xacro:lite_biped_debug_joint name="right_hip_roll" can_id="42" model="rs-06" direction="1"
                                  lower_limit="-1.5708" upper_limit="0.349066" torque_limit="36.0"
                                  current_limit="43"/>
    <xacro:lite_biped_debug_joint name="right_hip_yaw" can_id="43" model="rs-02" direction="1"
                                  lower_limit="-1.5708" upper_limit="1.5708" torque_limit="17.0"
                                  current_limit="27"/>
    <xacro:lite_biped_debug_joint name="right_knee_pitch" can_id="44" model="rs-06" direction="1"
                                  lower_limit="0.0" upper_limit="2.35619" torque_limit="36.0"
                                  current_limit="43"/>
    <xacro:lite_biped_debug_joint name="right_ankle_yaw" can_id="45" model="rs-00" direction="1"
                                  lower_limit="-1.5708" upper_limit="1.5708" torque_limit="14.0"
                                  current_limit="16"/>
    <xacro:lite_biped_debug_linkage_joint name="right_ankle_pitch" can_id="46" model="rs-00"
                                          direction="-1" lower_limit="-0.523599"
                                          upper_limit="0.872665" torque_limit="14.0"
                                          current_limit="16" linkage_ground="160.449369"
                                          linkage_crank_in="40.0" linkage_coupler="150.0"
                                          linkage_crank_out="40.0" linkage_alpha_zero="338.82213"
                                          linkage_sign="1" use_linkage="${use_linkage}"/>
    <xacro:lite_biped_debug_joint name="right_ankle_roll" can_id="47" model="rs-05" direction="-1"
                                  lower_limit="-0.349066" upper_limit="0.349066"
                                  torque_limit="5.5" current_limit="14"/>
  </xacro:macro>

  <!-- Mock and MuJoCo backends. One block per bus, carrying the same component
       names as the real backend, so anything keyed by component name means the
       same thing on every backend: a controller's safety_components, the
       hardware_spawner, the manager's hardware_components_initial_state. -->
  <xacro:macro name="lite_biped_debug_ros2_control_combined" params="sim_mujoco">
    <ros2_control name="LiteBipedLeftLeg" type="system">
      <hardware>
        <xacro:if value="${sim_mujoco}">
          <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim_mujoco}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>
      </hardware>
      <xacro:lite_biped_debug_left_leg_joints/>
      <xacro:unless value="${sim_mujoco}">
        <gpio name="LiteBipedLeftLeg">
          <state_interface name="safety_level"/>
          <state_interface name="safety_flags"/>
        </gpio>
      </xacro:unless>
    </ros2_control>
    <ros2_control name="LiteBipedRightLeg" type="system">
      <hardware>
        <xacro:if value="${sim_mujoco}">
          <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim_mujoco}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>
      </hardware>
      <xacro:lite_biped_debug_right_leg_joints/>
      <xacro:unless value="${sim_mujoco}">
        <gpio name="LiteBipedRightLeg">
          <state_interface name="safety_level"/>
          <state_interface name="safety_flags"/>
        </gpio>
      </xacro:unless>
    </ros2_control>
    <xacro:if value="${sim_mujoco}">
      <ros2_control name="LiteBipedIMU" type="sensor">
        <hardware>
          <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        </hardware>
        <sensor name="base_imu">
          <state_interface name="orientation.x"/>
          <state_interface name="orientation.y"/>
          <state_interface name="orientation.z"/>
          <state_interface name="orientation.w"/>
          <state_interface name="angular_velocity.x"/>
          <state_interface name="angular_velocity.y"/>
          <state_interface name="angular_velocity.z"/>
          <state_interface name="linear_acceleration.x"/>
          <state_interface name="linear_acceleration.y"/>
          <state_interface name="linear_acceleration.z"/>
        </sensor>
      </ros2_control>
    </xacro:if>
  </xacro:macro>

  <!-- Real hardware: one <ros2_control> block per CAN bus. The controller_manager
       runs them concurrently and exposes a single flat joint list to controllers. -->
  <xacro:macro name="lite_biped_debug_ros2_control_real"
               params="can_interface_left can_interface_right calibration_file imu_port
                       use_linkage">
    <ros2_control name="LiteBipedLeftLeg" type="system">
      <hardware>
        <plugin>humanoid_devices_robstride/RobstrideSystem</plugin>
        <param name="can_interface">${can_interface_left}</param>
        <param name="calibration_file">${calibration_file}</param>
      </hardware>
      <xacro:lite_biped_debug_left_leg_joints use_linkage="${use_linkage}"/>
    </ros2_control>
    <ros2_control name="LiteBipedRightLeg" type="system">
      <hardware>
        <plugin>humanoid_devices_robstride/RobstrideSystem</plugin>
        <param name="can_interface">${can_interface_right}</param>
        <param name="calibration_file">${calibration_file}</param>
      </hardware>
      <xacro:lite_biped_debug_right_leg_joints use_linkage="${use_linkage}"/>
    </ros2_control>
    <ros2_control name="LiteBipedIMU" type="sensor">
      <hardware>
        <plugin>humanoid_devices_witmotion/WitImuSensor</plugin>
        <param name="port">${imu_port}</param>
      </hardware>
      <sensor name="base_imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </ros2_control>
  </xacro:macro>

  <!-- Backend dispatch, following the Universal Robots description convention: one
       boolean per non-real backend, real hardware as the fallback when both are false.
       sim_mujoco wins over use_mock_hardware. -->
  <xacro:macro name="lite_biped_debug_ros2_control"
               params="use_mock_hardware sim_mujoco can_interface_left can_interface_right
                       calibration_file imu_port use_linkage">
    <xacro:if value="${sim_mujoco or use_mock_hardware}">
      <xacro:lite_biped_debug_ros2_control_combined sim_mujoco="${sim_mujoco}"/>
    </xacro:if>
    <xacro:unless value="${sim_mujoco or use_mock_hardware}">
      <xacro:lite_biped_debug_ros2_control_real
        can_interface_left="${can_interface_left}"
        can_interface_right="${can_interface_right}"
        calibration_file="${calibration_file}"
        imu_port="${imu_port}"
        use_linkage="${use_linkage}"/>
    </xacro:unless>
  </xacro:macro>

</robot>
