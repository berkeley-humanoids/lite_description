<?xml version="1.0"?>
<!-- GENERATED by lite_description.workflow from Onshape CAD. Do not edit by hand. Regenerate: lite-description-generate lite_dummy -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One joint: 5 command + 3 state interfaces (MIT mode).
       The params are read by humanoid_devices_robstride. The mock and MuJoCo backends
       ignore params they do not know, so this one macro serves all three. -->
  <xacro:macro name="lite_dummy_joint"
               params="name can_id model direction lower_limit upper_limit torque_limit
                       current_limit">
    <joint name="${name}">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="stiffness"/>
      <command_interface name="damping"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="can_id">${can_id}</param>
      <param name="model">${model}</param>
      <param name="direction">${direction}</param>
      <param name="lower_limit">${lower_limit}</param>
      <param name="upper_limit">${upper_limit}</param>
      <param name="torque_limit">${torque_limit}</param>
      <param name="current_limit">${current_limit}</param>
    </joint>
  </xacro:macro>

  <xacro:macro name="lite_dummy_left_arm_joints">
    <xacro:lite_dummy_joint name="left_shoulder_pitch" can_id="11" model="rs-02" direction="-1"
                            lower_limit="-3.14159" upper_limit="0.785398" torque_limit="17"
                            current_limit="27"/>
    <xacro:lite_dummy_joint name="left_shoulder_roll" can_id="12" model="rs-00" direction="-1"
                            lower_limit="-1.5708" upper_limit="1.91986" torque_limit="14"
                            current_limit="16"/>
    <xacro:lite_dummy_joint name="left_shoulder_yaw" can_id="13" model="rs-00" direction="1"
                            lower_limit="-1.5708" upper_limit="1.5708" torque_limit="14"
                            current_limit="16"/>
    <xacro:lite_dummy_joint name="left_elbow_pitch" can_id="14" model="rs-00" direction="-1"
                            lower_limit="-2.35619" upper_limit="0.0" torque_limit="14"
                            current_limit="16"/>
    <xacro:lite_dummy_joint name="left_wrist_yaw" can_id="15" model="rs-05" direction="1"
                            lower_limit="-1.5708" upper_limit="1.5708" torque_limit="4.0"
                            current_limit="14"/>
    <xacro:lite_dummy_joint name="left_wrist_roll" can_id="16" model="rs-05" direction="-1"
                            lower_limit="-0.698132" upper_limit="0.698132" torque_limit="4.0"
                            current_limit="14"/>
    <xacro:lite_dummy_joint name="left_wrist_pitch" can_id="17" model="rs-05" direction="-1"
                            lower_limit="-0.785398" upper_limit="0.785398" torque_limit="4.0"
                            current_limit="14"/>
  </xacro:macro>

  <xacro:macro name="lite_dummy_right_arm_joints">
    <xacro:lite_dummy_joint name="right_shoulder_pitch" can_id="21" model="rs-02" direction="1"
                            lower_limit="-3.14159" upper_limit="0.785398" torque_limit="17"
                            current_limit="27"/>
    <xacro:lite_dummy_joint name="right_shoulder_roll" can_id="22" model="rs-00" direction="-1"
                            lower_limit="-1.91986" upper_limit="1.5708" torque_limit="14"
                            current_limit="16"/>
    <xacro:lite_dummy_joint name="right_shoulder_yaw" can_id="23" model="rs-00" direction="1"
                            lower_limit="-1.5708" upper_limit="1.5708" torque_limit="14"
                            current_limit="16"/>
    <xacro:lite_dummy_joint name="right_elbow_pitch" can_id="24" model="rs-00" direction="1"
                            lower_limit="-2.35619" upper_limit="0.0" torque_limit="14"
                            current_limit="16"/>
    <xacro:lite_dummy_joint name="right_wrist_yaw" can_id="25" model="rs-05" direction="1"
                            lower_limit="-1.5708" upper_limit="1.5708" torque_limit="4.0"
                            current_limit="14"/>
    <xacro:lite_dummy_joint name="right_wrist_roll" can_id="26" model="rs-05" direction="1"
                            lower_limit="-0.698132" upper_limit="0.698132" torque_limit="4.0"
                            current_limit="14"/>
    <xacro:lite_dummy_joint name="right_wrist_pitch" can_id="27" model="rs-05" direction="-1"
                            lower_limit="-0.785398" upper_limit="0.785398" torque_limit="4.0"
                            current_limit="14"/>
  </xacro:macro>

  <!-- Mock and MuJoCo backends. One block per bus, carrying the same component
       names as the real backend, so anything keyed by component name means the
       same thing on every backend: a controller's safety_components, the
       hardware_spawner, the manager's hardware_components_initial_state. -->
  <xacro:macro name="lite_dummy_ros2_control_combined" params="sim_mujoco">
    <ros2_control name="LiteLeftArm" type="system">
      <hardware>
        <xacro:if value="${sim_mujoco}">
          <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim_mujoco}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>
      </hardware>
      <xacro:lite_dummy_left_arm_joints/>
      <xacro:unless value="${sim_mujoco}">
        <gpio name="LiteLeftArm">
          <state_interface name="safety_level"/>
          <state_interface name="safety_flags"/>
        </gpio>
      </xacro:unless>
    </ros2_control>
    <ros2_control name="LiteRightArm" type="system">
      <hardware>
        <xacro:if value="${sim_mujoco}">
          <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim_mujoco}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>
      </hardware>
      <xacro:lite_dummy_right_arm_joints/>
      <xacro:unless value="${sim_mujoco}">
        <gpio name="LiteRightArm">
          <state_interface name="safety_level"/>
          <state_interface name="safety_flags"/>
        </gpio>
      </xacro:unless>
    </ros2_control>
  </xacro:macro>

  <!-- Real hardware: one <ros2_control> block per CAN bus. The controller_manager
       runs them concurrently and exposes a single flat joint list to controllers. -->
  <xacro:macro name="lite_dummy_ros2_control_real"
               params="can_interface_left can_interface_right calibration_file">
    <ros2_control name="LiteLeftArm" type="system">
      <hardware>
        <plugin>humanoid_devices_robstride/RobstrideSystem</plugin>
        <param name="can_interface">${can_interface_left}</param>
        <param name="calibration_file">${calibration_file}</param>
      </hardware>
      <xacro:lite_dummy_left_arm_joints/>
    </ros2_control>
    <ros2_control name="LiteRightArm" type="system">
      <hardware>
        <plugin>humanoid_devices_robstride/RobstrideSystem</plugin>
        <param name="can_interface">${can_interface_right}</param>
        <param name="calibration_file">${calibration_file}</param>
      </hardware>
      <xacro:lite_dummy_right_arm_joints/>
    </ros2_control>
  </xacro:macro>

  <!-- Backend dispatch, following the Universal Robots description convention: one
       boolean per non-real backend, real hardware as the fallback when both are false.
       sim_mujoco wins over use_mock_hardware. -->
  <xacro:macro name="lite_dummy_ros2_control"
               params="use_mock_hardware sim_mujoco can_interface_left can_interface_right
                       calibration_file">
    <xacro:if value="${sim_mujoco or use_mock_hardware}">
      <xacro:lite_dummy_ros2_control_combined sim_mujoco="${sim_mujoco}"/>
    </xacro:if>
    <xacro:unless value="${sim_mujoco or use_mock_hardware}">
      <xacro:lite_dummy_ros2_control_real
        can_interface_left="${can_interface_left}"
        can_interface_right="${can_interface_right}"
        calibration_file="${calibration_file}"/>
    </xacro:unless>
  </xacro:macro>

</robot>
